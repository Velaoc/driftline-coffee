<% identity = Rails.configuration.x.foundation %>
<% title "Driftline Coffee — small-batch, roasted weekly" %>

<section class="md-hero" aria-labelledby="hero-title">
  <div class="md-hero__inner">
    <div>
      <p class="md-section__eyebrow"><%= identity[:application_name] %></p>
      <h1 id="hero-title">Roasted Tuesday, on your counter Friday.</h1>
      <p>Small-batch coffee from a neighborhood roaster. Single origins and blends roasted every week, bagged by hand, and shipped within two days of the roast.</p>
      <div class="md-actions">
        <%= link_to "Shop the roast", storefront_products_path, class: "md-button md-button--filled" %>
        <% if user_signed_in? %>
          <%= link_to "Your orders", storefront_orders_path, class: "md-button md-button--outlined" %>
        <% else %>
          <%= link_to "Create an account", new_user_registration_path, class: "md-button md-button--outlined" %>
        <% end %>
      </div>
    </div>
    <div class="md-hero__art" aria-hidden="true"><div class="md-hero__orb"></div></div>
  </div>
</section>

<section class="md-section" aria-labelledby="catalog-teaser-title">
  <div class="md-section__inner">
    <p class="md-section__eyebrow">This week's roast</p>
    <h2 id="catalog-teaser-title" class="md-section__heading">Fresh from the drum.</h2>
    <p>Every bag is roasted to order in small batches — light, medium, or dark, whole bean or ground on request. Here's what's on the shelf right now.</p>
    <% featured = Foundation::Storefront::Product.catalog.limit(3).to_a %>
    <% if featured.any? %>
      <div class="storefront-product-grid">
        <% featured.each do |product| %>
          <article class="md-card md-card--outlined storefront-product-card">
            <%= link_to storefront_product_path(product.slug), class: "storefront-product-card__image" do %>
              <%= storefront_product_image(product, alt: product.description.presence || product.name) %>
            <% end %>
            <div class="md-stack storefront-product-card__body">
              <div><h3><%= link_to product.name, storefront_product_path(product.slug) %></h3><p><%= truncate(product.description, length: 120) %></p></div>
              <strong><%= storefront_money(product.price_cents, product.currency) %></strong>
              <%= link_to "View product", storefront_product_path(product.slug), class: "md-button md-button--filled" %>
            </div>
          </article>
        <% end %>
      </div>
      <%= link_to "See the full catalog", storefront_products_path, class: "md-button md-button--tonal" %>
    <% end %>
  </div>
</section>

<section class="md-section" aria-labelledby="promise-title">
  <div class="md-section__inner">
    <p class="md-section__eyebrow">Why Driftline</p>
    <h2 id="promise-title" class="md-section__heading">Three things we won't cut corners on.</h2>
    <div class="md-grid">
      <article class="md-card md-card--filled md-feature">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:local_shipping, size: 32) %></span>
        <div>
          <h3>Roasted to order</h3>
          <p>No warehouse stock, no stale bags. Your coffee is roasted the week it ships and arrives with a roast date you can read.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:eco, size: 32) %></span>
        <div>
          <h3>Direct trade</h3>
          <p>We buy from farms we visit, pay well above commodity prices, and know the people who grew every lot we sell.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:support_agent, size: 32) %></span>
        <div>
          <h3>Real humans</h3>
          <p>A small team roasts, bags, and answers email. If a bag isn't right, tell us — we'll make it right or refund it.</p>
        </div>
      </article>
    </div>
  </div>
</section>
